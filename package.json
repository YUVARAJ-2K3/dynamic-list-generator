{
  "name": "dynamic-list-generator",
  "displayName": "Dynamic List Generator",
  "description": "Insert a list with any number of quoted values and navigate with Tab.",
  "version": "1.0.0",
  "publisher": "local",
  "license": "MIT",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Snippets", "Other"],
  "main": "./extension.js",
  "activationEvents": ["onCommand:listGenerator.create"],
  "contributes": {
    "commands": [{"command": "listGenerator.create", "title": "Generate List with N Elements"}],
    "keybindings": [{"command": "listGenerator.create", "key": "ctrl+alt+shift+l", "mac": "cmd+alt+shift+l", "when": "editorTextFocus"}]
  },
  "scripts": { "package": "vsce package --allow-missing-repository", "check": "node --check extension.js" },
  "devDependencies": { "@vscode/vsce": "^3.0.0" }
}